<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaborNatural">

        <!--
            Fase 1: la guía de estilos es la pantalla de arranque provisional.
            En la fase 2 el intent-filter MAIN/LAUNCHER pasa a la SplashActivity.
        -->
        <activity
            android:name=".ui.estilos.GuiaEstilosActivity"
            android:exported="true"
            android:theme="@style/Theme.SaborNatural.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
