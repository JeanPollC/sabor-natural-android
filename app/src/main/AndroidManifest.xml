<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lector de huella para el ingreso biométrico (RF-AUT-05) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaborNatural">

        <!-- Punto de entrada: el splash decide a dónde ir según la sesión guardada -->
        <activity
            android:name=".ui.inicio.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SaborNatural.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantallas comunes y de autenticación (no se pueden abrir desde otras apps) -->
        <activity
            android:name=".ui.inicio.BienvenidaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.IngresoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RecuperarClaveActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Paneles por rol -->
        <activity
            android:name=".ui.panel.PanelProvisionalActivity"
            android:exported="false" />

        <!-- Herramienta de desarrollo: guía de estilos (mantener presionado el logo en la bienvenida) -->
        <activity
            android:name=".ui.estilos.GuiaEstilosActivity"
            android:exported="false" />
    </application>

</manifest>
