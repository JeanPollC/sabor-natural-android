<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lector de huella para el ingreso biométrico (RF-AUT-05) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Firebase (Auth, Firestore, Storage, Functions) y la pasarela Wompi necesitan internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Ubicación para llenar la dirección de entrega (RF-PED-02). Se pide en tiempo de ejecución
        al pagar; el usuario puede conceder la precisa o solo la aproximada, o escribir la dirección.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".SaborNaturalApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SaborNatural">

        <!-- Punto de entrada: el splash decide a dónde ir según la sesión guardada -->
        <activity
            android:name=".ui.inicio.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SaborNatural.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantallas comunes y de autenticación (no se pueden abrir desde otras apps) -->
        <activity
            android:name=".ui.inicio.BienvenidaActivity"
            android:exported="false" />
        <activity
            android:name=".ui.auth.IngresoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RecuperarClaveActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.auth.RegistroActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Una Activity por rol; cada una muestra sus pantallas (Fragments) con barra inferior
            y menú lateral. adjustResize: el contenido se ajusta cuando aparece el teclado.
        -->
        <activity
            android:name=".ui.comprador.CompradorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.vendedor.VendedorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Web Checkout de Wompi en un WebView (sandbox) -->
        <activity
            android:name=".ui.comprador.PagoWompiActivity"
            android:exported="false" />

        <!-- Pantalla oculta: primer administrador y datos de ejemplo (mantener presionado el avatar del perfil) -->
        <activity
            android:name=".ui.admin.ConfiguracionInicialActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Herramienta de desarrollo: guía de estilos (mantener presionado el logo en la bienvenida) -->
        <activity
            android:name=".ui.estilos.GuiaEstilosActivity"
            android:exported="false" />
    </application>

</manifest>
