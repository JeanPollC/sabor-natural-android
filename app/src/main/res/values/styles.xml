<?xml version="1.0" encoding="utf-8"?>
<!--
    Estilos reutilizables: formas, apariencias de texto y estilos de componentes.
    El tema (themes.xml) los asigna como estilo por defecto; los layouts solo indican
    un estilo cuando necesitan una variante (por ejemplo, el botón de eliminar).
-->
<resources>

    <!-- ═════════ Formas ═════════ -->
    <style name="ShapeAppearance.SaborNatural.Pequena" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_s</item>
    </style>

    <style name="ShapeAppearance.SaborNatural.Mediana" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_m</item>
    </style>

    <style name="ShapeAppearance.SaborNatural.Grande" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radio_l</item>
    </style>

    <!-- Círculo para fotos de perfil -->
    <style name="ShapeAppearance.SaborNatural.Circulo" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Línea divisoria entre filas de una tarjeta (con sangría bajo el ícono) -->
    <style name="Widget.SaborNatural.Divisor" parent="Widget.Material3.MaterialDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="dividerColor">@color/borde</item>
        <item name="dividerInsetStart">56dp</item>
    </style>

    <!-- Píldora: esquinas al 50 % de la altura -->
    <style name="ShapeAppearance.SaborNatural.Pildora" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- ═════════ Apariencias de texto ═════════ -->
    <style name="TextAppearance.SaborNatural.Marca" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/texto_marca</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textColor">@color/verde_bosque</item>
    </style>

    <style name="TextAppearance.SaborNatural.Titulo" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextAppearance.SaborNatural.Subtitulo" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/texto_subtitulo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextAppearance.SaborNatural.Cuerpo" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="TextAppearance.SaborNatural.Secundario" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/texto_secundario</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="TextAppearance.SaborNatural.Etiqueta" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/texto_etiqueta</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.SaborNatural.Boton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/texto_cuerpo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.SaborNatural.Precio" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/texto_subtitulo</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/verde_bosque</item>
    </style>

    <!-- ═════════ Botones ═════════ -->
    <!-- Principal: verde bosque, forma de píldora, ancho completo en la mayoría de pantallas -->
    <style name="Widget.SaborNatural.Boton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Boton</item>
        <item name="backgroundTint">@color/selector_boton_principal</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SaborNatural.Pildora</item>
        <item name="iconTint">@color/blanco</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/espacio_s</item>
    </style>

    <!-- Botón de solo ícono, redondo y verde (por ejemplo, "agregar al carrito" en una tarjeta) -->
    <style name="Widget.SaborNatural.BotonIcono" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/verde_bosque</item>
        <item name="iconTint">@color/blanco</item>
        <item name="iconSize">20dp</item>
    </style>

    <!-- Secundario: fondo verde claro y texto verde (botón tonal) -->
    <style name="Widget.SaborNatural.Boton.Secundario" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Boton</item>
        <item name="backgroundTint">@color/verde_claro</item>
        <item name="android:textColor">@color/verde_bosque</item>
        <item name="iconTint">@color/verde_bosque</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SaborNatural.Pildora</item>
    </style>

    <!-- Contorno: borde verde sobre fondo transparente -->
    <style name="Widget.SaborNatural.Boton.Contorno" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Boton</item>
        <item name="strokeColor">@color/verde_bosque</item>
        <item name="strokeWidth">@dimen/borde_fino</item>
        <item name="android:textColor">@color/verde_bosque</item>
        <item name="iconTint">@color/verde_bosque</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SaborNatural.Pildora</item>
    </style>

    <!-- Claro: botón blanco con texto verde, para fondos verdes (bienvenida) -->
    <style name="Widget.SaborNatural.Boton.Claro">
        <item name="backgroundTint">@color/blanco</item>
        <item name="android:textColor">@color/verde_bosque</item>
        <item name="iconTint">@color/verde_bosque</item>
    </style>

    <!-- Contorno claro: borde y texto blancos, para fondos verdes -->
    <style name="Widget.SaborNatural.Boton.ContornoClaro" parent="Widget.SaborNatural.Boton.Contorno">
        <item name="strokeColor">@color/blanco</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="iconTint">@color/blanco</item>
    </style>

    <!-- Texto claro: enlace blanco sobre fondo verde -->
    <style name="Widget.SaborNatural.Boton.TextoClaro" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Boton</item>
        <item name="android:textColor">@color/verde_claro</item>
    </style>

    <!-- Opción de un grupo de selección (por ejemplo, comprador o vendedor en el registro) -->
    <style name="Widget.SaborNatural.BotonAlternar" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/alto_boton</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Boton</item>
        <item name="backgroundTint">@color/selector_ficha_fondo</item>
        <item name="android:textColor">@color/selector_ficha_texto</item>
        <item name="iconTint">@color/selector_ficha_texto</item>
        <item name="strokeColor">@color/borde</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Contorno rojo: cerrar sesión y acciones destructivas secundarias -->
    <style name="Widget.SaborNatural.Boton.ContornoPeligro" parent="Widget.SaborNatural.Boton.Contorno">
        <item name="strokeColor">@color/rojo</item>
        <item name="android:textColor">@color/rojo</item>
        <item name="iconTint">@color/rojo</item>
    </style>

    <!-- Texto: enlaces como "¿Olvidaste tu contraseña?" -->
    <style name="Widget.SaborNatural.Boton.Texto" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Boton</item>
        <item name="android:textColor">@color/verde_bosque</item>
        <item name="iconTint">@color/verde_bosque</item>
    </style>

    <!-- Peligro: rojo, reservado para eliminar, cancelar y rechazar (documento, sección 5.1) -->
    <style name="Widget.SaborNatural.Boton.Peligro" parent="Widget.SaborNatural.Boton">
        <item name="backgroundTint">@color/rojo</item>
    </style>

    <!-- ═════════ Campos de texto ═════════ -->
    <style name="Widget.SaborNatural.Campo" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/blanco</item>
        <item name="boxStrokeColor">@color/selector_borde_campo</item>
        <item name="boxStrokeWidth">@dimen/borde_fino</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_m</item>
        <item name="hintTextColor">@color/verde_bosque</item>
        <item name="startIconTint">@color/verde_bosque</item>
        <item name="endIconTint">@color/texto_secundario</item>
        <item name="helperTextTextColor">@color/texto_secundario</item>
        <item name="errorTextColor">@color/rojo</item>
        <item name="boxStrokeErrorColor">@color/rojo</item>
    </style>

    <!-- Campo con lista desplegable (categoría, rol) -->
    <style name="Widget.SaborNatural.Campo.Desplegable" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/blanco</item>
        <item name="boxStrokeColor">@color/selector_borde_campo</item>
        <item name="boxCornerRadiusTopStart">@dimen/radio_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radio_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radio_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radio_m</item>
        <item name="hintTextColor">@color/verde_bosque</item>
        <item name="startIconTint">@color/verde_bosque</item>
        <item name="endIconTint">@color/verde_bosque</item>
    </style>

    <!-- ═════════ Tarjetas ═════════ -->
    <style name="Widget.SaborNatural.Tarjeta" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/blanco</item>
        <item name="strokeColor">@color/borde</item>
        <item name="strokeWidth">@dimen/borde_fino</item>
        <item name="cardElevation">@dimen/elevacion_tarjeta</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SaborNatural.Grande</item>
    </style>

    <!-- ═════════ Fichas de filtro ═════════ -->
    <style name="Widget.SaborNatural.Ficha" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/selector_ficha_fondo</item>
        <item name="android:textColor">@color/selector_ficha_texto</item>
        <item name="chipStrokeColor">@color/borde</item>
        <item name="chipStrokeWidth">@dimen/borde_fino</item>
        <item name="checkedIconTint">@color/verde_bosque</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SaborNatural.Pildora</item>
    </style>

    <!-- ═════════ Barras de navegación ═════════ -->
    <style name="Widget.SaborNatural.BarraInferior" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/blanco</item>
        <item name="itemIconTint">@color/selector_barra_inferior</item>
        <item name="itemTextColor">@color/selector_barra_inferior</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.SaborNatural.BarraInferior.Indicador</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.SaborNatural.Etiqueta</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.SaborNatural.Etiqueta</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.SaborNatural.BarraInferior.Indicador" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/verde_claro</item>
    </style>

    <style name="Widget.SaborNatural.BarraSuperior" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/verde_bosque</item>
        <item name="titleTextColor">@color/blanco</item>
        <item name="subtitleTextColor">@color/verde_claro</item>
        <item name="navigationIconTint">@color/blanco</item>
        <item name="titleTextAppearance">@style/TextAppearance.SaborNatural.BarraSuperior</item>
    </style>

    <style name="TextAppearance.SaborNatural.BarraSuperior" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/texto_subtitulo</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ═════════ Botones flotantes ═════════ -->
    <style name="Widget.SaborNatural.BotonFlotante" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/verde_bosque</item>
        <item name="tint">@color/blanco</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SaborNatural.Grande</item>
    </style>

    <style name="Widget.SaborNatural.BotonFlotanteExtendido" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="backgroundTint">@color/verde_bosque</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="iconTint">@color/blanco</item>
        <item name="shapeAppearance">@style/ShapeAppearance.SaborNatural.Pildora</item>
    </style>

    <!-- ═════════ Interruptores ═════════ -->
    <style name="Widget.SaborNatural.Interruptor" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/selector_interruptor_pista</item>
        <item name="thumbTint">@color/blanco</item>
        <item name="trackDecorationTint">@color/borde</item>
    </style>

    <!-- ═════════ Etiquetas de estado (texto sobre una píldora de color) ═════════ -->
    <style name="Widget.SaborNatural.Etiqueta" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_etiqueta</item>
        <item name="android:paddingStart">@dimen/espacio_m</item>
        <item name="android:paddingEnd">@dimen/espacio_m</item>
        <item name="android:paddingTop">@dimen/espacio_xs</item>
        <item name="android:paddingBottom">@dimen/espacio_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Etiqueta</item>
    </style>

    <style name="Widget.SaborNatural.Etiqueta.Exito">
        <item name="android:backgroundTint">@color/estado_exito_fondo</item>
        <item name="android:textColor">@color/estado_exito_texto</item>
    </style>

    <style name="Widget.SaborNatural.Etiqueta.Pendiente">
        <item name="android:backgroundTint">@color/estado_pendiente_fondo</item>
        <item name="android:textColor">@color/estado_pendiente_texto</item>
    </style>

    <style name="Widget.SaborNatural.Etiqueta.Error">
        <item name="android:backgroundTint">@color/estado_error_fondo</item>
        <item name="android:textColor">@color/estado_error_texto</item>
    </style>

    <style name="Widget.SaborNatural.Etiqueta.Info">
        <item name="android:backgroundTint">@color/estado_info_fondo</item>
        <item name="android:textColor">@color/estado_info_texto</item>
    </style>

    <!-- Aviso dentro de un formulario: bloque redondeado de color con texto -->
    <style name="Widget.SaborNatural.Aviso" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_aviso</item>
        <item name="android:padding">@dimen/espacio_m</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Secundario</item>
        <item name="android:drawablePadding">@dimen/espacio_s</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Widget.SaborNatural.Aviso.Error">
        <item name="android:backgroundTint">@color/estado_error_fondo</item>
        <item name="android:textColor">@color/estado_error_texto</item>
    </style>

    <style name="Widget.SaborNatural.Aviso.Pendiente">
        <item name="android:backgroundTint">@color/estado_pendiente_fondo</item>
        <item name="android:textColor">@color/estado_pendiente_texto</item>
    </style>

    <style name="Widget.SaborNatural.Aviso.Info">
        <item name="android:backgroundTint">@color/estado_info_fondo</item>
        <item name="android:textColor">@color/estado_info_texto</item>
    </style>

    <!-- Casilla de verificación (autorizaciones del registro) -->
    <style name="Widget.SaborNatural.Casilla" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Secundario</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="buttonTint">@color/selector_casilla</item>
        <item name="android:paddingStart">@dimen/espacio_xs</item>
    </style>

    <!-- Fila de beneficio: ícono a la izquierda y texto blanco (bienvenida) -->
    <style name="Widget.SaborNatural.Beneficio" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:drawablePadding">@dimen/espacio_m</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Cuerpo</item>
        <item name="android:textColor">@color/blanco</item>
        <item name="drawableTint">@color/lima</item>
    </style>

    <!-- Fila de opción del perfil: ícono, texto y flecha; toda la fila es tocable -->
    <style name="Widget.SaborNatural.FilaOpcion" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">@dimen/espacio_l</item>
        <item name="android:paddingEnd">@dimen/espacio_l</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:drawablePadding">@dimen/espacio_l</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Cuerpo</item>
        <item name="drawableTint">@color/verde_bosque</item>
        <item name="drawableEndCompat">@drawable/ic_chevron</item>
    </style>

    <!-- Menú lateral (NavigationView): destino activo en verde claro -->
    <style name="Widget.SaborNatural.MenuLateral" parent="Widget.Material3.NavigationView">
        <item name="android:background">@color/blanco</item>
        <item name="itemIconTint">@color/selector_barra_inferior</item>
        <item name="itemTextColor">@color/selector_barra_inferior</item>
        <item name="itemShapeFillColor">@color/selector_menu_lateral_fondo</item>
        <item name="itemTextAppearance">@style/TextAppearance.SaborNatural.Cuerpo</item>
        <item name="drawerLayoutCornerSize">@dimen/radio_l</item>
    </style>

    <!-- Tarjeta que se puede marcar (medio de pago, tipo de entrega) -->
    <style name="Widget.SaborNatural.TarjetaSeleccionable" parent="Widget.SaborNatural.Tarjeta">
        <item name="android:checkable">true</item>
        <item name="strokeColor">@color/selector_borde_seleccion</item>
        <item name="strokeWidth">2dp</item>
        <item name="checkedIcon">@null</item>
        <item name="cardForegroundColor">@android:color/transparent</item>
    </style>

    <!-- Botones + y − del selector de cantidad -->
    <style name="Widget.SaborNatural.BotonCantidad" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="iconTint">@color/verde_bosque</item>
        <item name="strokeColor">@color/borde</item>
        <item name="iconSize">18dp</item>
        <item name="android:minWidth">40dp</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <!-- Indicador numérico (paneles del vendedor y del administrador) -->
    <style name="TextAppearance.SaborNatural.Indicador" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_principal</item>
    </style>

    <style name="TextAppearance.SaborNatural.Precio.Grande">
        <item name="android:textSize">26sp</item>
    </style>

    <!-- Indicador de pasos de la compra -->
    <style name="Widget.SaborNatural.Paso" parent="">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:background">@drawable/bg_paso</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Etiqueta</item>
    </style>

    <style name="Widget.SaborNatural.EtiquetaPaso" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">@dimen/espacio_xs</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Etiqueta</item>
    </style>

    <style name="Widget.SaborNatural.LineaPaso" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/espacio_s</item>
        <item name="android:layout_marginEnd">@dimen/espacio_s</item>
        <item name="android:background">@color/borde</item>
    </style>

    <!-- Par etiqueta/valor dentro de una tarjeta (rótulo, recibo, datos del pedido) -->
    <style name="Widget.SaborNatural.EtiquetaDato" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Etiqueta</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>

    <style name="Widget.SaborNatural.ValorDato" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">@dimen/espacio_xxs</item>
        <item name="android:textAppearance">@style/TextAppearance.SaborNatural.Cuerpo</item>
    </style>

    <!-- Título de sección dentro de una pantalla larga -->
