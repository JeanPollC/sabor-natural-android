<?xml version="1.0" encoding="utf-8"?>
<!-- Encabezado de los paneles del vendedor y del administrador: menú, saludo, subtítulo y avatar. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_encabezado_curvo"
    android:paddingStart="@dimen/espacio_s"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="@dimen/margen_pantalla"
    android:paddingBottom="@dimen/espacio_xxl">

    <ImageButton
        android:id="@+id/botonMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/menu_abrir"
        android:src="@drawable/ic_menu"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/blanco" />

    <TextView
        android:id="@+id/avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circulo_suave"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo"
        android:textColor="@color/verde_bosque"
        app:layout_constraintBottom_toBottomOf="@id/botonMenu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/botonMenu"
        tools:text="HL" />

    <TextView
        android:id="@+id/saludo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_m"
        android:layout_marginTop="@dimen/espacio_s"
        android:textAppearance="@style/TextAppearance.SaborNatural.Marca"
        android:textColor="@color/blanco"
        android:textSize="26sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/botonMenu"
        tools:text="Hola, Huerta" />

    <TextView
        android:id="@+id/subtitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
        android:textColor="@color/verde_claro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/saludo"
        app:layout_constraintTop_toBottomOf="@id/saludo"
        tools:text="Panel del vendedor" />
</androidx.constraintlayout.widget.ConstraintLayout>
