<?xml version="1.0" encoding="utf-8"?>
<!-- Contenido del diálogo mientras la pasarela procesa el pago: indicador circular y texto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/espacio_xl">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="@color/verde_bosque"
        app:indicatorSize="56dp"
        app:trackColor="@color/verde_claro"
        app:trackThickness="5dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_l"
        android:text="@string/pago_procesando"
        android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:text="@string/pago_procesando_detalle"
        android:textAppearance="@style/TextAppearance.SaborNatural.Secundario" />
</LinearLayout>
