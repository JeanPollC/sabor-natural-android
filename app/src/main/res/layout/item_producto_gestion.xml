<?xml version="1.0" encoding="utf-8"?>
<!--
    Producto en las listas de gestión (V-02 del vendedor y A-05 del administrador):
    imagen, nombre, resumen, estado de publicación, aviso (motivo de rechazo o estado del
    rótulo) y botón de más opciones.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/espacio_m">

        <FrameLayout
            android:id="@+id/marcoImagen"
            android:layout_width="@dimen/tamano_imagen_lista"
            android:layout_height="@dimen/tamano_imagen_lista"
            android:background="@drawable/bg_imagen_producto"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/foto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icono"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/botonOpciones"
            app:layout_constraintStart_toEndOf="@id/marcoImagen"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Bebida de almendras sin azúcar" />

        <TextView
            android:id="@+id/resumen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
            app:layout_constraintEnd_toEndOf="@id/nombre"
            app:layout_constraintStart_toStartOf="@id/nombre"
            app:layout_constraintTop_toBottomOf="@id/nombre"
            tools:text="$ 14.900 · 24 en existencia" />

        <TextView
            android:id="@+id/estado"
            style="@style/Widget.SaborNatural.Etiqueta.Exito"
            android:layout_marginTop="@dimen/espacio_xs"
            app:layout_constraintStart_toStartOf="@id/nombre"
            app:layout_constraintTop_toBottomOf="@id/resumen"
            tools:text="Publicado" />

        <TextView
            android:id="@+id/etiquetaExtra"
            style="@style/Widget.SaborNatural.Etiqueta.Pendiente"
            android:layout_marginStart="@dimen/espacio_xs"
            android:visibility="gone"
            app:layout_constraintBaseline_toBaselineOf="@id/estado"
            app:layout_constraintStart_toEndOf="@id/estado"
            tools:text="Pocas unidades"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/aviso"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xs"
            android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
            android:textColor="@color/rojo"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/nombre"
            app:layout_constraintTop_toBottomOf="@id/estado"
            tools:text="Motivo: falta el registro sanitario en el rótulo."
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/botonOpciones"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/accion_mas_opciones"
            android:src="@drawable/ic_mas_opciones"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/texto_secundario" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
