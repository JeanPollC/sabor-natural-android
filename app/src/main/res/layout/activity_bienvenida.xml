<?xml version="1.0" encoding="utf-8"?>
<!--
    Bienvenida (mockup C-01). Fondo con el degradado de la marca y tres salidas:
    ingresar, crear cuenta o explorar el catálogo sin cuenta (RF-INI-01, RF-INI-02).
    ConstraintLayout: la marca arriba, los beneficios en el centro y los botones anclados abajo.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degradado_marca"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/margen_pantalla"
    android:paddingTop="@dimen/espacio_xl"
    android:paddingEnd="@dimen/margen_pantalla"
    android:paddingBottom="@dimen/espacio_l"
    tools:context=".ui.inicio.BienvenidaActivity">

    <!-- Hoja decorativa grande, casi transparente -->
    <ImageView
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-120dp"
        android:alpha="0.07"
        android:importantForAccessibility="no"
        android:rotation="-20"
        android:src="@drawable/ic_hoja"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/blanco" />

    <!-- Marca -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/descripcion_logo"
        android:src="@drawable/ic_logo_marca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_m"
        android:text="@string/app_name"
        android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo"
        android:textColor="@color/blanco"
        app:layout_constraintBottom_toBottomOf="@id/logo"
        app:layout_constraintStart_toEndOf="@id/logo"
        app:layout_constraintTop_toTopOf="@id/logo" />

    <!-- Mensaje principal -->
    <TextView
        android:id="@+id/titulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xxl"
        android:text="@string/bienvenida_titulo"
        android:textAppearance="@style/TextAppearance.SaborNatural.Marca"
        android:textColor="@color/blanco"
        android:textSize="34sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo" />

    <TextView
        android:id="@+id/eslogan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:text="@string/eslogan"
        android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
        android:textColor="@color/verde_claro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titulo" />

    <!-- Beneficios: tarjeta translúcida con tres filas de ícono y texto -->
    <LinearLayout
        android:id="@+id/beneficios"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xl"
        android:background="@drawable/bg_tarjeta_translucida"
        android:orientation="vertical"
        android:padding="@dimen/espacio_l"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/eslogan">

        <TextView
            style="@style/Widget.SaborNatural.Beneficio"
            android:text="@string/bienvenida_beneficio_productores"
            app:drawableStartCompat="@drawable/ic_verificado" />

        <TextView
            style="@style/Widget.SaborNatural.Beneficio"
            android:layout_marginTop="@dimen/espacio_m"
            android:text="@string/bienvenida_beneficio_pago"
            app:drawableStartCompat="@drawable/ic_tarjeta" />

        <TextView
            style="@style/Widget.SaborNatural.Beneficio"
            android:layout_marginTop="@dimen/espacio_m"
            android:text="@string/bienvenida_beneficio_envio"
            app:drawableStartCompat="@drawable/ic_envio" />
    </LinearLayout>

    <!-- Acciones, ancladas abajo y al alcance del pulgar -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonIngresar"
        style="@style/Widget.SaborNatural.Boton.Claro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/bienvenida_ingresar"
        app:layout_constraintBottom_toTopOf="@id/botonCrearCuenta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonCrearCuenta"
        style="@style/Widget.SaborNatural.Boton.ContornoClaro"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_s"
        android:text="@string/bienvenida_crear_cuenta"
        app:layout_constraintBottom_toTopOf="@id/botonExplorar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonExplorar"
        style="@style/Widget.SaborNatural.Boton.TextoClaro"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:text="@string/bienvenida_explorar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
