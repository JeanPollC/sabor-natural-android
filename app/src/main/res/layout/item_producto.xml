<?xml version="1.0" encoding="utf-8"?>
<!--
    Tarjeta de producto del catálogo (cuadrícula de 2 columnas y fila horizontal de destacados).
    Imagen arriba (foto o ilustración de la categoría), nombre, productor, calificación,
    precio y botón para agregar al carrito.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_xs">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/espacio_s">

        <FrameLayout
            android:id="@+id/marcoImagen"
            android:layout_width="0dp"
            android:layout_height="@dimen/alto_imagen_tarjeta"
            android:background="@drawable/bg_imagen_producto"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/foto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/icono"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                tools:src="@drawable/ic_bebida" />

            <TextView
                android:id="@+id/etiquetaExistencias"
                style="@style/Widget.SaborNatural.Etiqueta.Error"
                android:layout_margin="@dimen/espacio_s"
                android:visibility="gone"
                tools:text="@string/formato_agotado"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/nombre"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:ellipsize="end"
            android:lines="2"
            android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/marcoImagen"
            tools:text="Bebida de almendras sin azúcar" />

        <TextView
            android:id="@+id/vendedor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
            android:textColor="@color/texto_secundario"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nombre"
            tools:text="Huerta La Montaña" />

        <TextView
            android:id="@+id/calificacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xxs"
            android:drawablePadding="@dimen/espacio_xxs"
            android:gravity="center_vertical"
            android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
            android:textColor="@color/texto_principal"
            app:drawableStartCompat="@drawable/ic_estrella_pequena"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/vendedor"
            tools:text="4,8 (36)" />

        <TextView
            android:id="@+id/precio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SaborNatural.Precio"
            android:textSize="@dimen/texto_cuerpo"
            app:layout_constraintBottom_toBottomOf="@id/botonAgregar"
            app:layout_constraintEnd_toStartOf="@id/botonAgregar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/botonAgregar"
            tools:text="$ 14.900" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAgregar"
            style="@style/Widget.SaborNatural.BotonIcono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/accion_agregar_carrito"
            app:icon="@drawable/ic_agregar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/calificacion" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
