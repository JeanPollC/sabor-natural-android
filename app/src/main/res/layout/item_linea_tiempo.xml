<?xml version="1.0" encoding="utf-8"?>
<!-- Una fila de la línea de tiempo del pedido: ícono (cumplido o pendiente) y nombre del estado. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/espacio_xs"
    android:paddingBottom="@dimen/espacio_xs">

    <ImageView
        android:id="@+id/icono"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_check_circulo" />

    <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/espacio_m"
        android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
        tools:text="Confirmado" />
</LinearLayout>
