<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash de Sabor Natural. Continúa la pantalla de bienvenida del sistema (mismo verde) y
    anima la marca mientras se cargan los datos y se verifica si hay una sesión abierta.
    FrameLayout: apila el contenido centrado y el indicador de carga anclado abajo.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_degradado_marca"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/espacio_xxl">

    <!-- Hoja decorativa de fondo, casi transparente -->
    <ImageView
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-110dp"
        android:alpha="0.07"
        android:importantForAccessibility="no"
        android:rotation="-20"
        android:src="@drawable/ic_hoja"
        app:tint="@color/blanco" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/descripcion_logo"
            android:src="@drawable/ic_logo_marca" />

        <TextView
            android:id="@+id/nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xl"
            android:text="@string/app_name"
            android:textAppearance="@style/TextAppearance.SaborNatural.Marca"
            android:textColor="@color/blanco" />

        <TextView
            android:id="@+id/eslogan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:gravity="center"
            android:text="@string/eslogan"
            android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
            android:textColor="@color/verde_claro" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            app:indicatorColor="@color/lima"
            app:trackColor="@color/verde_hoja"
            app:trackCornerRadius="4dp"
            app:trackThickness="4dp" />

        <TextView
            android:id="@+id/version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
            android:textColor="@color/verde_claro" />
    </LinearLayout>
</FrameLayout>
