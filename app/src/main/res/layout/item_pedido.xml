<?xml version="1.0" encoding="utf-8"?>
<!--
    Pedido en una lista (B-07 del comprador, V-05 del vendedor y compras del administrador):
    código, estado, contraparte (productor o comprador), fecha, unidades y total.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/espacio_s"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/espacio_l">

        <FrameLayout
            android:id="@+id/circulo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circulo_suave"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_pedidos"
                app:tint="@color/verde_bosque" />
        </FrameLayout>

        <TextView
            android:id="@+id/codigo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_m"
            android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/estado"
            app:layout_constraintStart_toEndOf="@id/circulo"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="SN-482913" />

        <TextView
            android:id="@+id/estado"
            style="@style/Widget.SaborNatural.Etiqueta.Info"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="En preparación" />

        <TextView
            android:id="@+id/contraparte"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
            android:textColor="@color/texto_principal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/codigo"
            app:layout_constraintTop_toBottomOf="@id/codigo"
            tools:text="Huerta La Montaña" />

        <TextView
            android:id="@+id/detalle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xxs"
            android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
            android:textColor="@color/texto_secundario"
            app:layout_constraintEnd_toStartOf="@id/total"
            app:layout_constraintStart_toStartOf="@id/codigo"
            app:layout_constraintTop_toBottomOf="@id/contraparte"
            tools:text="12 oct 2026, 10:24 a. m. · 3 productos" />

        <TextView
            android:id="@+id/total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SaborNatural.Precio"
            android:textSize="@dimen/texto_cuerpo"
            app:layout_constraintBaseline_toBaselineOf="@id/detalle"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="$ 46.700" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
