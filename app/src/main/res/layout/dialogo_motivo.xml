<?xml version="1.0" encoding="utf-8"?>
<!-- Campo del diálogo de rechazo: el motivo es obligatorio y lo verá el vendedor (RF-ADP-02). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/espacio_xl"
    android:paddingTop="@dimen/espacio_s"
    android:paddingEnd="@dimen/espacio_xl">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/campoMotivo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/moderacion_motivo"
        app:helperText="@string/moderacion_motivo_ayuda">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="200" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
