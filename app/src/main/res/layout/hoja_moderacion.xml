<?xml version="1.0" encoding="utf-8"?>
<!--
    Hoja inferior de moderación (mockup A-05, RF-ADP-02 y RF-ADP-03): resumen del producto,
    verificación del rótulo y acciones. "Aprobar" se bloquea si el rótulo está incompleto.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/moderacion_titulo"
            android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/marcoImagen"
                android:layout_width="@dimen/tamano_imagen_lista"
                android:layout_height="@dimen/tamano_imagen_lista"
                android:background="@drawable/bg_imagen_producto">

                <ImageView
                    android:id="@+id/foto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/icono"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espacio_m"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/nombre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
                    android:textStyle="bold"
                    tools:text="Leche de coco" />

                <TextView
                    android:id="@+id/resumen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
                    tools:text="Huerta La Montaña · $ 13.900" />

                <TextView
                    android:id="@+id/etiquetaRotulo"
                    style="@style/Widget.SaborNatural.Etiqueta.Exito"
                    android:layout_marginTop="@dimen/espacio_xs"
                    tools:text="Rótulo completo" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/espacio_l">

                <TextView
                    style="@style/Widget.SaborNatural.EtiquetaDato"
                    android:text="@string/detalle_ingredientes" />

                <TextView
                    android:id="@+id/ingredientes"
                    style="@style/Widget.SaborNatural.ValorDato"
                    tools:text="Agua, pulpa de coco (12 %)." />

                <TextView
                    style="@style/Widget.SaborNatural.EtiquetaDato"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:text="@string/detalle_contenido_neto" />

                <TextView
                    android:id="@+id/contenido"
                    style="@style/Widget.SaborNatural.ValorDato"
                    tools:text="1 L" />

                <TextView
                    style="@style/Widget.SaborNatural.EtiquetaDato"
                    android:layout_marginTop="@dimen/espacio_m"
                    android:text="@string/detalle_registro_sanitario" />

                <TextView
                    android:id="@+id/registro"
                    style="@style/Widget.SaborNatural.ValorDato"
                    tools:text="Pendiente de registro" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/avisoBloqueo"
            style="@style/Widget.SaborNatural.Aviso.Error"
            android:layout_marginTop="@dimen/espacio_m"
            android:text="@string/moderacion_aprobar_bloqueado"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_alerta"
            app:drawableTint="@color/rojo"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAprobar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_l"
            android:text="@string/accion_aprobar"
            app:icon="@drawable/ic_check_circulo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonRechazar"
            style="@style/Widget.SaborNatural.Boton.ContornoPeligro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:text="@string/accion_rechazar"
            app:icon="@drawable/ic_cerrar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonSuspender"
            style="@style/Widget.SaborNatural.Boton.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            android:text="@string/moderacion_suspender"
            app:icon="@drawable/ic_pausa" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
