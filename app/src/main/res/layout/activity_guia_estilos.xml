<?xml version="1.0" encoding="utf-8"?>
<!--
    Guía de estilos (fase 1). Reúne en una sola pantalla los recursos de values, drawables y
    estilos del proyecto, para comprobar el tema antes de construir las pantallas por rol.

    Estructura: LinearLayout vertical con tres partes
      1. Encabezado con degradado y esquinas curvas (drawable bg_encabezado_curvo).
      2. NestedScrollView con las secciones (ocupa el espacio sobrante gracias a layout_weight).
      3. Barra de navegación inferior.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- 1. Encabezado: ConstraintLayout para ubicar el logo a la izquierda y los textos a su lado -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado_curvo"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_xl"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_xl">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/descripcion_logo"
            android:src="@drawable/ic_logo_marca"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_l"
            android:text="@string/guia_titulo"
            android:textAppearance="@style/TextAppearance.SaborNatural.Titulo"
            android:textColor="@color/texto_sobre_marca"
            app:layout_constraintBottom_toTopOf="@id/subtitulo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/logo"
            app:layout_constraintTop_toTopOf="@id/logo"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/subtitulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_xxs"
            android:text="@string/guia_subtitulo"
            android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
            android:textColor="@color/verde_claro"
            app:layout_constraintBottom_toBottomOf="@id/logo"
            app:layout_constraintEnd_toEndOf="@id/titulo"
            app:layout_constraintStart_toStartOf="@id/titulo"
            app:layout_constraintTop_toBottomOf="@id/titulo" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 2. Contenido desplazable -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/espacio_xl">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla">

            <!-- Paleta: GridLayout de 4 columnas; las muestras se agregan desde Kotlin -->
            <TextView
                style="@style/Widget.SaborNatural.TituloSeccion"
                android:text="@string/guia_seccion_colores" />

            <GridLayout
                android:id="@+id/grillaPaleta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:useDefaultMargins="false" />

            <!-- Botones: el principal hereda el estilo del tema; los demás indican su variante -->
            <TextView
                style="@style/Widget.SaborNatural.TituloSeccion"
                android:text="@string/guia_seccion_botones" />

            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guia_boton_primario"
                app:icon="@drawable/ic_hoja" />

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.SaborNatural.Boton.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:text="@string/guia_boton_secundario" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.SaborNatural.Boton.Contorno"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:text="@string/accion_cancelar" />

                <com.google.android.material.button.MaterialButton
                    style="@style/Widget.SaborNatural.Boton.Peligro"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/guia_boton_peligro"
                    app:icon="@drawable/ic_eliminar" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                style="@style/Widget.SaborNatural.Boton.Texto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/espacio_xs"
                android:text="@string/guia_boton_texto" />

            <!-- Campos de texto: TextInputLayout con contorno, ícono inicial y texto de ayuda -->
            <TextView
                style="@style/Widget.SaborNatural.TituloSeccion"
                android:text="@string/guia_seccion_campos" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/guia_campo_correo"
                app:helperText="@string/guia_campo_correo_ayuda"
                app:startIconDrawable="@drawable/ic_correo">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_s"
                android:hint="@string/guia_campo_clave"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_candado">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Etiquetas de estado y fichas de filtro -->
            <TextView
                style="@style/Widget.SaborNatural.TituloSeccion"
                android:text="@string/guia_seccion_estados" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="@dimen/espacio_s">

                <TextView
                    style="@style/Widget.SaborNatural.Etiqueta.Exito"
                    android:text="@string/guia_estado_publicado" />

                <TextView
                    style="@style/Widget.SaborNatural.Etiqueta.Pendiente"
                    android:text="@string/guia_estado_revision" />

                <TextView
                    style="@style/Widget.SaborNatural.Etiqueta.Error"
                    android:text="@string/guia_estado_rechazado" />

                <TextView
                    style="@style/Widget.SaborNatural.Etiqueta.Info"
                    android:text="@string/guia_estado_nuevo" />
            </com.google.android.material.chip.ChipGroup>

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/categoria_todos" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_bebidas" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_panaderia" />

                <com.google.android.material.chip.Chip
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/categoria_semillas" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Tarjeta de producto: MaterialCardView con ConstraintLayout interno -->
            <TextView
                style="@style/Widget.SaborNatural.TituloSeccion"
                android:text="@string/guia_seccion_tarjeta" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/espacio_m">

                    <FrameLayout
                        android:id="@+id/fotoProducto"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:background="@drawable/bg_imagen_producto"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:layout_width="@dimen/tamano_icono_grande"
                            android:layout_height="@dimen/tamano_icono_grande"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_hoja"
                            app:tint="@color/verde_hoja" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/nombreProducto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/espacio_m"
                        android:text="@string/guia_producto_nombre"
                        android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo"
                        android:textSize="@dimen/texto_cuerpo"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/fotoProducto"
                        app:layout_constraintTop_toTopOf="@id/fotoProducto" />

                    <TextView
                        android:id="@+id/vendedorProducto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xxs"
                        android:text="@string/guia_producto_vendedor"
                        android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
                        app:layout_constraintEnd_toEndOf="@id/nombreProducto"
                        app:layout_constraintStart_toStartOf="@id/nombreProducto"
                        app:layout_constraintTop_toBottomOf="@id/nombreProducto" />

                    <TextView
                        android:id="@+id/calificacionProducto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs"
                        android:drawablePadding="@dimen/espacio_xs"
                        android:gravity="center_vertical"
                        android:text="@string/guia_producto_calificacion"
                        android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
                        android:textColor="@color/texto_principal"
                        app:drawableStartCompat="@drawable/ic_estrella"
                        app:drawableTint="@color/calificacion"
                        app:layout_constraintStart_toStartOf="@id/nombreProducto"
                        app:layout_constraintTop_toBottomOf="@id/vendedorProducto" />

                    <TextView
                        android:id="@+id/precioProducto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/guia_producto_precio"
                        android:textAppearance="@style/TextAppearance.SaborNatural.Precio"
                        app:layout_constraintBottom_toBottomOf="@id/fotoProducto"
                        app:layout_constraintStart_toStartOf="@id/nombreProducto" />

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/agregarProducto"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/accion_agregar_carrito"
                        android:src="@drawable/ic_agregar"
                        app:fabSize="mini"
                        app:layout_constraintBottom_toBottomOf="@id/fotoProducto"
                        app:layout_constraintEnd_toEndOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 3. Barra inferior: el estilo del tema le da fondo blanco e indicador verde claro -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/barraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_guia_inferior" />

</LinearLayout>
