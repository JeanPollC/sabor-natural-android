<?xml version="1.0" encoding="utf-8"?>
<!--
    Panel provisional de la fase 2: confirma con qué rol se ingresó y permite cerrar sesión.
    En las fases 3 a 5 se reemplaza por el panel completo de cada rol, con su barra inferior.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.panel.PanelProvisionalActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_encabezado_curvo"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_l"
        android:paddingEnd="@dimen/espacio_s"
        android:paddingBottom="@dimen/espacio_xl">

        <!-- Avatar con las iniciales del usuario sobre un círculo verde claro -->
        <TextView
            android:id="@+id/avatar"
            android:layout_width="@dimen/tamano_avatar"
            android:layout_height="@dimen/tamano_avatar"
            android:background="@drawable/bg_circulo_suave"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.SaborNatural.Titulo"
            android:textColor="@color/verde_bosque"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="LG" />

        <TextView
            android:id="@+id/saludo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/espacio_l"
            android:textAppearance="@style/TextAppearance.SaborNatural.Titulo"
            android:textColor="@color/blanco"
            app:layout_constraintBottom_toTopOf="@id/etiquetaRol"
            app:layout_constraintEnd_toStartOf="@id/botonSalir"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintTop_toTopOf="@id/avatar"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Hola, Laura" />

        <TextView
            android:id="@+id/etiquetaRol"
            style="@style/Widget.SaborNatural.Etiqueta.Info"
            android:layout_marginTop="@dimen/espacio_xs"
            app:layout_constraintBottom_toBottomOf="@id/avatar"
            app:layout_constraintStart_toStartOf="@id/saludo"
            app:layout_constraintTop_toBottomOf="@id/saludo"
            tools:text="Administrador" />

        <ImageButton
            android:id="@+id/botonSalir"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/panel_cerrar_sesion"
            android:src="@drawable/ic_salir"
            app:layout_constraintBottom_toBottomOf="@id/avatar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/avatar"
            app:tint="@color/blanco" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/contenido"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/margen_pantalla">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/espacio_l">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circulo_suave">

                    <ImageView
                        android:id="@+id/iconoRol"
                        android:layout_width="@dimen/tamano_icono"
                        android:layout_height="@dimen/tamano_icono"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:tint="@color/verde_bosque"
                        tools:src="@drawable/ic_panel" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textoPanel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/espacio_l"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
                    tools:text="@string/panel_texto" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCerrarSesion"
            style="@style/Widget.SaborNatural.Boton.Contorno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/panel_cerrar_sesion"
            app:icon="@drawable/ic_salir" />
    </LinearLayout>
</LinearLayout>
