<?xml version="1.0" encoding="utf-8"?>
<!--
    Reporte de ventas del administrador: periodo (fichas), cuatro indicadores, gráfico de barras
    por categoría (vista propia GraficoBarras, dibujada con Canvas), ventas por productor,
    productos más vendidos y últimos pedidos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.admin.ReporteVentasFragment">

    <include
        android:id="@+id/barra"
        layout="@layout/include_barra_superior" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/espacio_xl">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/fichasPeriodo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espacio_l"
                android:paddingEnd="@dimen/espacio_l">

                <include
                    android:id="@+id/indicador1"
                    layout="@layout/include_indicador" />

                <include
                    android:id="@+id/indicador2"
                    layout="@layout/include_indicador" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="@dimen/espacio_l"
                android:paddingEnd="@dimen/espacio_l">

                <include
                    android:id="@+id/indicador3"
                    layout="@layout/include_indicador" />

                <include
                    android:id="@+id/indicador4"
                    layout="@layout/include_indicador" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingEnd="@dimen/margen_pantalla">

                <!-- Gráfico por categoría -->
                <TextView
                    style="@style/Widget.SaborNatural.TituloSeccion"
                    android:text="@string/reporte_por_categoria" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.sabornatural.tienda.ui.admin.GraficoBarras
                        android:id="@+id/grafico"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_margin="@dimen/espacio_l" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Por productor -->
                <TextView
                    style="@style/Widget.SaborNatural.TituloSeccion"
                    android:text="@string/reporte_por_vendedor" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/listaVendedores"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_l" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Más vendidos -->
                <TextView
                    style="@style/Widget.SaborNatural.TituloSeccion"
                    android:text="@string/reporte_mas_vendidos" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/listaMasVendidos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/espacio_l" />
                </com.google.android.material.card.MaterialCardView>

                <!-- Últimos pedidos -->
                <TextView
                    style="@style/Widget.SaborNatural.TituloSeccion"
                    android:text="@string/reporte_ultimos" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listaPedidos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_pedido" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/espacio_s"
                    android:text="@string/reporte_nota"
                    android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
                    android:textColor="@color/texto_secundario" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
