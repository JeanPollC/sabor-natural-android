<?xml version="1.0" encoding="utf-8"?>
<!--
    Crear o editar usuario (mockups A-03 y A-04, RF-ADU-02 a RF-ADU-06). El mismo formulario sirve
    para el alta y la edición: datos, rol (lista desplegable), estado de la cuenta, solicitud de
    vendedor pendiente (aprobar o rechazar) y eliminación en rojo.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.admin.FormularioUsuarioFragment">

    <include
        android:id="@+id/barra"
        layout="@layout/include_barra_superior" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <!-- Solicitud de vendedor pendiente (A-04) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/tarjetaSolicitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/espacio_l"
                android:visibility="gone"
                app:cardBackgroundColor="@color/estado_pendiente_fondo"
                app:strokeColor="@color/ambar"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/espacio_s"
                        android:gravity="center_vertical"
                        android:text="@string/usuario_solicitud_titulo"
                        android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo"
                        android:textColor="@color/estado_pendiente_texto"
                        app:drawableStartCompat="@drawable/ic_tienda"
                        app:drawableTint="@color/estado_pendiente_texto" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_xs"
                        android:text="@string/usuario_solicitud_texto"
                        android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
                        android:textColor="@color/texto_principal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonRechazarSolicitud"
                            style="@style/Widget.SaborNatural.Boton.ContornoPeligro"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/espacio_s"
                            android:layout_weight="1"
                            android:text="@string/accion_rechazar" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/botonAprobarSolicitud"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/accion_aprobar" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Datos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoNombre"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/espacio_s"
                    android:layout_weight="1"
                    android:hint="@string/registro_nombre">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/campoApellido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/registro_apellido">

                    <com.google.android.material.textfield.TextInputEditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLength="50" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoCorreo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:hint="@string/ingreso_correo"
                app:startIconDrawable="@drawable/ic_correo">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoTelefono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:hint="@string/registro_telefono"
                app:startIconDrawable="@drawable/ic_telefono">

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLength="10" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoRol"
                style="@style/Widget.SaborNatural.Campo.Desplegable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m"
                android:hint="@string/usuario_rol"
                app:startIconDrawable="@drawable/ic_usuarios">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/listaRol"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:layout_marginBottom="@dimen/espacio_s"
                android:text="@string/usuario_estado"
                android:textAppearance="@style/TextAppearance.SaborNatural.Secundario" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/grupoEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/opcionActiva"
                    style="@style/Widget.SaborNatural.BotonAlternar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/estado_activo" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/opcionPendiente"
                    style="@style/Widget.SaborNatural.BotonAlternar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/estado_pendiente" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/opcionSuspendida"
                    style="@style/Widget.SaborNatural.BotonAlternar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/estado_suspendido" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <TextView
                android:id="@+id/avisoClave"
                style="@style/Widget.SaborNatural.Aviso.Info"
                android:layout_marginTop="@dimen/espacio_l"
                android:text="@string/usuario_aviso_clave"
                app:drawableStartCompat="@drawable/ic_correo"
                app:drawableTint="@color/verde_bosque" />

            <TextView
                android:id="@+id/registrado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
                android:textColor="@color/texto_secundario"
                tools:text="Registrado el 2 de septiembre de 2026" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonEliminar"
                style="@style/Widget.SaborNatural.Boton.ContornoPeligro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_l"
                android:text="@string/usuario_eliminar"
                app:icon="@drawable/ic_eliminar" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/barraAccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_accion"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_m"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accion_guardar" />
    </FrameLayout>
</LinearLayout>
