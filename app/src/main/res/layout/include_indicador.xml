<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de indicador (paneles del vendedor y del administrador): ícono, valor grande y etiqueta. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/espacio_xs"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/espacio_l">

        <FrameLayout
            android:id="@+id/circulo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circulo_suave">

            <ImageView
                android:id="@+id/icono"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/verde_bosque"
                tools:src="@drawable/ic_dinero" />
        </FrameLayout>

        <TextView
            android:id="@+id/valor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.SaborNatural.Indicador"
            tools:text="$ 245.300" />

        <TextView
            android:id="@+id/etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
            android:textColor="@color/texto_secundario"
            tools:text="Ventas del mes" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
