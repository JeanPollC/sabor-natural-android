<?xml version="1.0" encoding="utf-8"?>
<!--
    Detalle del pedido (mockups B-08 y V-06, RF-PED-04 a RF-PED-07): línea de tiempo de estados,
    datos de la contraparte y la entrega, productos con totales y pago. Abajo, las acciones
    según el rol: el vendedor avanza o rechaza el pedido; el comprador puede cancelarlo
    mientras no se haya despachado.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.compartido.DetallePedidoFragment">

    <include
        android:id="@+id/barra"
        layout="@layout/include_barra_superior" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margen_pantalla">

            <!-- Estado y línea de tiempo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detalle_pedido_estado"
                            android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo" />

                        <TextView
                            android:id="@+id/estado"
                            style="@style/Widget.SaborNatural.Etiqueta.Info"
                            tools:text="En preparación" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/fecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.SaborNatural.Secundario"
                        tools:text="7 nov 2026, 6:05 p. m." />

                    <!-- Las filas de la línea de tiempo se agregan desde Kotlin -->
                    <LinearLayout
                        android:id="@+id/lineaTiempo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Contraparte y entrega -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espacio_m">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/espacio_l">

                    <TextView
                        android:id="@+id/etiquetaContraparte"
                        style="@style/Widget.SaborNatural.EtiquetaDato"
                        tools:text="@string/detalle_pedido_productor" />

                    <TextView
                        android:id="@+id/contraparte"
                        style="@style/Widget.SaborNatural.ValorDato"
                        android:textStyle="bold"
                        tools:text="Huerta La Montaña" />

                    <TextView
                        android:id="@+id/telefono"
                        style="@style/Widget.SaborNatural.ValorDato"
                        android:drawablePadding="@dimen/espacio_s"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_telefono"
                        app:drawableTint="@color/verde_bosque"
                        tools:text="Celular 3205551234" />

                    <TextView
                        style="@style/Widget.SaborNatural.EtiquetaDato"
                        android:layout_marginTop="@dimen/espacio_m"
                        android:text="@string/detalle_pedido_entrega" />

                    <TextView
                        android:id="@+id/entrega"
                        style="@style/Widget.SaborNatural.ValorDato"
                        android:drawablePadding="@dimen/espacio_s"
                        android:gravity="center_vertical"
                        app:drawableStartCompat="@drawable/ic_ubicacion"
                        app:drawableTint="@color/verde_bosque"
                        tools:text="Domicilio · Calle 14 # 4-63, Centro, Ibagué" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Productos -->
            <TextView
                style="@style/Widget.SaborNatural.TituloSeccion"
                android:text="@string/detalle_pedido_productos" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/listaLineas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/espacio_l"
                        android:paddingTop="@dimen/espacio_m"
                        android:paddingEnd="@dimen/espacio_l" />

                    <include
                        android:id="@+id/totales"
                        layout="@layout/include_totales" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pago -->
            <TextView
                style="@style/Widget.SaborNatural.TituloSeccion"
                android:text="@string/detalle_pedido_pago" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- shrinkColumns: la columna de valores se ajusta al ancho y parte en varias líneas los
                     textos largos (la referencia de Wompi), sin empujar los demás valores fuera de la vista -->
                <TableLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/espacio_l"
                    android:shrinkColumns="1"
                    android:stretchColumns="1">

                    <TableRow>

                        <TextView
                            android:text="@string/confirmacion_medio"
                            android:textAppearance="@style/TextAppearance.SaborNatural.Secundario" />

                        <TextView
                            android:id="@+id/medio"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
                            tools:text="Tarjeta débito o crédito" />
                    </TableRow>

                    <TableRow android:layout_marginTop="@dimen/espacio_s">

                        <TextView
                            android:text="@string/confirmacion_referencia"
                            android:textAppearance="@style/TextAppearance.SaborNatural.Secundario" />

                        <TextView
                            android:id="@+id/referencia"
                            android:layout_marginStart="@dimen/espacio_m"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.SaborNatural.Cuerpo"
                            tools:text="WMP-120771" />
                    </TableRow>
                </TableLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/barraAccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_barra_accion"
        android:orientation="vertical"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingTop="@dimen/espacio_m"
        android:paddingEnd="@dimen/margen_pantalla"
        android:paddingBottom="@dimen/espacio_m">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAvanzar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_check_circulo"
            tools:text="Marcar como En preparación" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonCancelar"
            style="@style/Widget.SaborNatural.Boton.ContornoPeligro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_s"
            tools:text="@string/detalle_pedido_rechazar" />
    </LinearLayout>
</LinearLayout>
