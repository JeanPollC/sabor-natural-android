<?xml version="1.0" encoding="utf-8"?>
<!-- Una muestra de la paleta: cuadro de color y su nombre. La guía de estilos la repite por cada color. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/espacio_xs">

    <View
        android:id="@+id/muestra"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_muestra_color"
        tools:backgroundTint="@color/verde_bosque" />

    <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
        android:textColor="@color/texto_secundario"
        tools:text="@string/guia_color_principal" />
</LinearLayout>
