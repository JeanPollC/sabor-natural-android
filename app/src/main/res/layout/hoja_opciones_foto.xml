<?xml version="1.0" encoding="utf-8"?>
<!-- Hoja inferior (BottomSheet) con las opciones de foto: cámara, galería o quitarla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/espacio_s"
    android:paddingBottom="@dimen/espacio_xl">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/espacio_l"
        android:paddingEnd="@dimen/espacio_l"
        android:paddingBottom="@dimen/espacio_s"
        android:text="@string/editar_perfil_cambiar_foto"
        android:textAppearance="@style/TextAppearance.SaborNatural.Subtitulo" />

    <TextView
        android:id="@+id/opcionCamara"
        style="@style/Widget.SaborNatural.FilaOpcion"
        android:text="@string/editar_perfil_tomar_foto"
        app:drawableEndCompat="@null"
        app:drawableStartCompat="@drawable/ic_camara" />

    <TextView
        android:id="@+id/opcionGaleria"
        style="@style/Widget.SaborNatural.FilaOpcion"
        android:text="@string/editar_perfil_elegir_galeria"
        app:drawableEndCompat="@null"
        app:drawableStartCompat="@drawable/ic_galeria" />

    <TextView
        android:id="@+id/opcionQuitar"
        style="@style/Widget.SaborNatural.FilaOpcion"
        android:text="@string/editar_perfil_quitar_foto"
        android:textColor="@color/rojo"
        app:drawableEndCompat="@null"
        app:drawableStartCompat="@drawable/ic_eliminar"
        app:drawableTint="@color/rojo" />
</LinearLayout>
