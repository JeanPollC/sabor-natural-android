<?xml version="1.0" encoding="utf-8"?>
<!-- Categoría en la fila horizontal del inicio: círculo de color con ícono y nombre debajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="80dp"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackgroundBorderless"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="@dimen/espacio_xs"
    android:paddingBottom="@dimen/espacio_xs">

    <FrameLayout
        android:id="@+id/circulo"
        android:layout_width="@dimen/tamano_categoria"
        android:layout_height="@dimen/tamano_categoria"
        android:background="@drawable/bg_circulo_suave">

        <ImageView
            android:id="@+id/icono"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            tools:src="@drawable/ic_bebida" />
    </FrameLayout>

    <TextView
        android:id="@+id/nombre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_xs"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.SaborNatural.Etiqueta"
        android:textColor="@color/texto_principal"
        tools:text="Bebidas" />
</LinearLayout>
