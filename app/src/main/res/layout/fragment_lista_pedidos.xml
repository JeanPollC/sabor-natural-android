<?xml version="1.0" encoding="utf-8"?>
<!--
    Lista de pedidos con filtros por estado. Sirve a dos roles:
      - comprador: "Mis pedidos" (mockup B-07);
      - vendedor: "Pedidos recibidos", su historial de ventas (mockup V-05).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.compartido.ListaPedidosFragment">

    <include
        android:id="@+id/barra"
        layout="@layout/include_barra_superior" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espacio_m"
        android:clipToPadding="false"
        android:paddingStart="@dimen/margen_pantalla"
        android:paddingEnd="@dimen/margen_pantalla"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/fichasEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listaPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingTop="@dimen/espacio_m"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_l"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_pedido" />

        <include
            android:id="@+id/estadoVacio"
            layout="@layout/include_estado_vacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>
</LinearLayout>
