<?xml version="1.0" encoding="utf-8"?>
<!--
    Administración de usuarios (mockup A-02, RF-ADU-01): búsqueda, filtros por rol y estado,
    lista y botón flotante para crear un usuario.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.admin.UsuariosFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/barra"
            layout="@layout/include_barra_superior" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bloque_verde_curvo"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:paddingBottom="@dimen/espacio_l">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/campoBuscar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxCornerRadiusBottomEnd="@dimen/radio_xl"
                app:boxCornerRadiusBottomStart="@dimen/radio_xl"
                app:boxCornerRadiusTopEnd="@dimen/radio_xl"
                app:boxCornerRadiusTopStart="@dimen/radio_xl"
                app:boxStrokeWidth="0dp"
                app:endIconMode="clear_text"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_buscar">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/textoBuscar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/usuarios_buscar"
                    android:imeOptions="actionSearch"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espacio_m"
            android:clipToPadding="false"
            android:paddingStart="@dimen/margen_pantalla"
            android:paddingEnd="@dimen/margen_pantalla"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/fichasFiltro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listaUsuarios"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/margen_pantalla"
                android:paddingTop="@dimen/espacio_m"
                android:paddingEnd="@dimen/margen_pantalla"
                android:paddingBottom="96dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_usuario" />

            <include
                android:id="@+id/estadoVacio"
                layout="@layout/include_estado_vacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/botonNuevo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/margen_pantalla"
        android:text="@string/usuarios_nuevo"
        app:icon="@drawable/ic_agregar" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>
