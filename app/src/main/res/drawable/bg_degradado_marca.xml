<?xml version="1.0" encoding="utf-8"?>
<!-- Degradado diagonal de la marca, del verde bosque oscuro al verde hoja. Fondo de encabezados y bienvenida. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/verde_bosque"
        android:endColor="@color/verde_hoja"
        android:startColor="@color/verde_bosque_oscuro"
        android:type="linear" />
</shape>
