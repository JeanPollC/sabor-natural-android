<?xml version="1.0" encoding="utf-8"?>
<!-- Cuadro redondeado para las muestras de la paleta; se colorea con backgroundTint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/blanco" />
    <!-- Borde fino para que los colores claros (crema, verde claro) se distingan del fondo -->
    <stroke
        android:width="@dimen/borde_fino"
        android:color="@color/gris_suave" />
    <corners android:radius="@dimen/radio_m" />
</shape>
