# Variables NO secretas de las Cloud Functions (opcional).
# Si las necesitas, copia este archivo como functions/.env (ese archivo no se sube a git).
#
# Los secretos (WOMPI_INTEGRITY_SECRET y, si usas el webhook, WOMPI_EVENTS_SECRET) NO van aquí:
# se guardan con   firebase functions:secrets:set NOMBRE   y la consola los pide sin mostrarlos.

# API de Wompi: sandbox para pruebas (valor por defecto) o producción.
# WOMPI_API_URL=https://sandbox.wompi.co/v1

# Webhook de eventos de Wompi (opcional). Wompi admite UNA sola URL de eventos por comercio:
# actívalo solo si esa URL puede apuntar a este proyecto. Requiere además
#   firebase functions:secrets:set WOMPI_EVENTS_SECRET
# HABILITAR_WEBHOOK_WOMPI=true
